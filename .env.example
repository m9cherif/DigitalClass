# DigitalClass configuration.
#
# None of this is required for local development: with no variables set the app
# stores data in data/*.json and starts fine. In production set these in your
# host's dashboard (Hostinger: Node.js app -> environment variables) — you do
# not need to ship a .env file.

PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# --- Storage ---------------------------------------------------------------
# Set these and everything is stored in MySQL/MariaDB instead of on disk, so
# data survives redeploys. The app creates its own tables on first boot.
# MYSQL_* names and a single DATABASE_URL=mysql://user:pass@host:3306/db work too.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# Supabase is supported as an alternative (used only when no MySQL vars are
# set). Run sql/001_initial_schema.sql first, and use the SERVICE ROLE key —
# never the anon/publishable one.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Uploads ---------------------------------------------------------------
# Uploaded files default to public/uploads, which lives inside the deployed
# directory and is wiped on each release. Point this at a path outside the
# deploy root to keep them.
# UPLOAD_DIR=/home/<account>/persistent/uploads

# --- Live classroom --------------------------------------------------------
# Optional TURN relay. Without it, peers behind strict school firewalls may
# fail to connect (plain STUN is used by default).
# TURN_URL=turn:turn.example.com:3478
# TURN_USER=
# TURN_PASS=
