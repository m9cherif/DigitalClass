# DigitalClass configuration.
#
# None of this is required for local development: with no variables set the app
# stores data in data/*.json and starts fine. In production set these in your
# host's dashboard (Hostinger: Node.js app -> environment variables) — you do
# not need to ship a .env file.

PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# --- Storage ---------------------------------------------------------------
# Provide these and the app stores everything in Supabase instead of on disk,
# so data survives redeploys. Use the SERVICE ROLE key (server-side only, it
# bypasses row-level security) — never the anon/publishable key.
# SUPABASE_URL / SUPABASE_PROJECT_URL / SUPABASE_API_URL are all accepted, as
# are SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SERVICE_KEY / SUPABASE_KEY.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Live classroom --------------------------------------------------------
# Optional TURN relay. Without it, peers behind strict school firewalls may
# fail to connect (plain STUN is used by default).
# TURN_URL=turn:turn.example.com:3478
# TURN_USER=
# TURN_PASS=
