{
  "name": "digitalclass",
  "version": "1.0.0",
  "description": "DigitalClass — trilingual (FR/EN/AR) online computer-science education platform for teachers, students and parents, with live quiz parties and 16 quiz types.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "reset": "node server/seed.js --force",
    "migrate": "node server/migrate-to-supabase.js",
    "migrate:dry": "node server/migrate-to-supabase.js --dry"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "socket.io": "^4.7.5"
  },
  "license": "MIT"
}
